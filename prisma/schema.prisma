// Prisma schema for Mompuffs: social feed + multi-vendor marketplace + POD imports.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  displayName   String
  bio           String?
  avatarUrl     String?
  createdAt     DateTime @default(now())

  posts         Post[]
  comments      Comment[]
  likes         Like[]

  following     Follow[]  @relation("Follower")
  followers     Follow[]  @relation("Following")

  shop          Shop?
  orders        Order[]
}

model Follow {
  id          String   @id @default(cuid())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Post {
  id        String    @id @default(cuid())
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  imageUrl  String?
  // Optional: a post can showcase a product from the author's shop
  product   Product?  @relation(fields: [productId], references: [id])
  productId String?
  createdAt DateTime  @default(now())

  comments  Comment[]
  likes     Like[]
}

model Comment {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())
}

model Like {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

// A Shop is a member-owned storefront. One shop per user in this prototype.
model Shop {
  id          String    @id @default(cuid())
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String    @unique
  slug        String    @unique
  name        String
  description String?
  bannerUrl   String?
  createdAt   DateTime  @default(now())

  products    Product[]
}

// NOTE: SQLite has no native enum support in Prisma, so ProductSource and
// OrderStatus are plain strings here instead of `enum` blocks. The
// application code treats them as closed sets:
//   Product.source -> "MANUAL" | "PRINTIFY" | "PRINTFUL" | "PEAPRINT"
//   Order.status   -> "PENDING" | "PAID" | "FULFILLED" | "CANCELLED"
// If you migrate to Postgres/MySQL for production, you can convert these
// back to real `enum` types.

model Product {
  id            String        @id @default(cuid())
  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId        String
  title         String
  description   String?
  priceCents    Int
  currency      String        @default("USD")
  imageUrl      String?
  source        String        @default("MANUAL")
  // Original ID from the POD provider's catalog, if imported
  externalId    String?
  externalMeta  String?       // raw JSON blob from the provider, for reference/debugging
  createdAt     DateTime      @default(now())

  posts         Post[]
  orderItems    OrderItem[]
  variants      ProductVariant[]
  categories    Category[]    @relation("ProductCategories")
}

// Two-level category tree (e.g. Apparel -> Men's Apparel) shared across all
// shops. A product can belong to any number of categories at once, so a
// design "collection" (e.g. "Mom Puffs") and a type category (e.g. "Men's
// Apparel") can both apply to the same product.
model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?
  children  Category[] @relation("CategoryChildren")
  products  Product[]  @relation("ProductCategories")
  createdAt DateTime   @default(now())
}

// Imported POD products may have multiple purchasable options (e.g. size/color),
// each with its own price. Manually-added products have no variants -- the
// base Product.priceCents is used directly in that case.
model ProductVariant {
  id          String      @id @default(cuid())
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  // Original variant ID from the POD provider's catalog
  externalId  String?
  label       String
  priceCents  Int
  currency    String      @default("USD")
  isAvailable Boolean     @default(true)
  // Variant-specific photo (e.g. the mockup for this color), if the provider has one
  imageUrl    String?
  // JSON map of option name -> value, e.g. {"Colors":"Black","Sizes":"S"}, used to
  // group the variant picker (by color, by size, ...) instead of a flat list
  optionsJson String?
  createdAt   DateTime    @default(now())

  orderItems  OrderItem[]
}

// Prototype checkout is simulated -- no real payment processor is wired up.
model Order {
  id          String      @id @default(cuid())
  buyer       User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId     String
  status      String      @default("PENDING")
  totalCents  Int
  createdAt   DateTime    @default(now())

  items       OrderItem[]
}

model OrderItem {
  id             String          @id @default(cuid())
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  product        Product         @relation(fields: [productId], references: [id])
  productId      String
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  variantId      String?
  // Snapshot of the variant's label at purchase time, so order history still
  // reads correctly even if the variant is later removed/changed.
  variantLabel   String?
  quantity       Int             @default(1)
  unitPriceCents Int
}
