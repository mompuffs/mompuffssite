# --- Core ---
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Image uploads ---
# Vercel dashboard > your project > Storage > Create Database > Blob.
# Once created, Vercel auto-injects this into your project's env vars;
# for local dev, copy the token from Storage > (your blob store) > .env.local tab.
BLOB_READ_WRITE_TOKEN=""

# --- Print-on-demand integrations ---
# Each shop connects its own Printify/Printful/Peaprint account from its
# dashboard's Connections page (src/app/dashboard/shop/connections) -- stored
# encrypted per shop in the database, with no shared/global fallback. No env
# vars needed here.
