# --- Core ---
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Image uploads ---
# Vercel dashboard > your project > Storage > Create Database > Blob.
# Once created, Vercel auto-injects this into your project's env vars;
# for local dev, copy the token from Storage > (your blob store) > .env.local tab.
BLOB_READ_WRITE_TOKEN=""

# --- Print-on-demand integrations ---
# Printify: My Profile > Connections > generate a Personal Access Token
PRINTIFY_API_KEY=""
PRINTIFY_SHOP_ID=""

# Printful: Developer Portal > create a Private Token
PRINTFUL_API_KEY=""

# Peaprint: no public developer API docs were found as of Aug 2026.
# If you have a Peaprint API key/endpoint from their support team, add it here
# and update src/lib/pod/peaprint.ts to match their real request/response shape.
PEAPRINT_API_KEY=""
PEAPRINT_API_BASE=""
